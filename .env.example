# Supabase Database Configuration
SUPABASE_PROJECT_ID="your_supabase_project_id"
SUPABASE_URL="https://your_supabase_project_id.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_URL="https://your_supabase_project_id.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio: Automatically injected at runtime from user secrets.
# Netlify: Add GEMINI_API_KEY (or GOOGLE_API_KEY) in Netlify Dashboard under Site configuration > Environment variables.
# When not provided or during rate limits, the academic fallback engine generates collegiate summaries and quizzes automatically.
GEMINI_API_KEY="MY_GEMINI_API_KEY"


# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT Secret for Auth
JWT_SECRET="ai_book_super_secret_jwt_key_2026"

# Optional MySQL Database connection parameters (if connecting to external MySQL server)
# When not specified, the system utilizes the high-performance embedded relational SQL engine with zero setup.
MYSQL_HOST=""
MYSQL_PORT="3306"
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_DATABASE=""
